---
import { iconPath } from "@/lib/icons";

interface Props {
  icon: string;
  class?: string;
  title?: string;
  width?: number;
  height?: number;
  loading?: "lazy" | "eager";
}

/** Collections that ship as currentColor silhouettes — need masking to pick up text color. */
const MONOCHROME_COLLECTIONS = new Set([
  "simple-icons",
  "file-icons",
  "grommet-icons",
  "mdi",
  "lineicons",
]);

const {
  icon,
  class: className = "",
  title,
  width = 24,
  height = 24,
  loading = "lazy",
} = Astro.props;

const collection = icon.split(":")[0] ?? "";
const src = iconPath(icon);
const monochrome = MONOCHROME_COLLECTIONS.has(collection);
---

{monochrome ? (
  <span
    role="img"
    aria-label={title || undefined}
    title={title}
    class:list={["inline-block shrink-0 bg-current", className]}
    style={`width:${width}px;height:${height}px;mask-image:url(${src});mask-repeat:no-repeat;mask-position:center;mask-size:contain;-webkit-mask-image:url(${src});-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;-webkit-mask-size:contain;`}
  />
) : (
  <img
    src={src}
    alt=""
    class={className}
    title={title}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
)}
